#!/bin/bash
# Use SbarLua's bundled lua 5.5 — the .so embeds 5.5 ABI; nixpkgs ships 5.4
# which segfaults at module load. The lua binary is dropped next to sketchybar.so
# by the home-manager activation script (modules/home/sketchybar.nix).
exec "$HOME/.local/share/sketchybar_lua/lua" - <<'LUA'
local config_dir = os.getenv("HOME") .. "/.config/sketchybar"
package.path = config_dir .. "/?.lua;" .. config_dir .. "/?/init.lua;" .. package.path
package.cpath = os.getenv("HOME") .. "/.local/share/sketchybar_lua/?.so;" .. package.cpath
require("init")
LUA
