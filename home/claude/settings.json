{
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "extraKnownMarketplaces": {
    "tada-skills": {
      "source": {
        "source": "file",
        "path": "/Users/tada/dotfiles/home/claude/marketplace.json"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@tada-skills": true,
    "devops-skills@tada-skills": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "env": {
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/caveman-track.sh"
          }
        ]
      }
    ]
  }
}
